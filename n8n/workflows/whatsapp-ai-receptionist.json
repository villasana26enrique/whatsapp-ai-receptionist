    {
      "id": "edbf57a9-23a0-4008-adb6-51e2df46e97e",
      "name": "Merge pending messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2688,
        416
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Only the execution of the latest message from this number continues; the others end silently\nconst current = $('Extract message data').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.message_id);\nif (!rows.length || rows[rows.length - 1].message_id !== current.message_id) {\n  return [];\n}\n\nreturn [{ json: {\n  ...current,\n  text: rows.map(r => r.text).join('\\n'),\n  message_count: rows.length,\n  last_buffer_id: Math.max(...rows.map(r => Number(r.id)))\n} }];"
      }
    },
