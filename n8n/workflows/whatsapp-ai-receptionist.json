      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- ON CONFLICT: a message Meta delivers twice is buffered (and answered) only once\nINSERT INTO dental_clinic.pending_messages (phone, message_id, text)\nVALUES ($1, $2, $3)\nON CONFLICT (message_id) DO NOTHING\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.from, $json.message_id, $json.text] }}"
        }
      },
      "credentials": {
